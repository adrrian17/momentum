# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# @import(../server/, pick=[NODE_ENV])
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Dedicated synthetic account for local E2E only; never browser exposed.
# @optional @sensitive @type=email
AUTH_TEST_EMAIL=

# Isolated local Alchemy stage and browser origin for E2E.
# @type=string(pattern="^e2e-[a-zA-Z0-9_-]+$")
AUTH_TEST_STAGE=e2e-bootstrap
# @type=url
AUTH_TEST_BASE_URL=http://localhost:3001
