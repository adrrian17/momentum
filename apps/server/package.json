{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@momentum/api": "workspace:*",
    "@momentum/auth": "workspace:*",
    "@momentum/db": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "evlog": "^2.29.0",
    "hono": "^4.13.12",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@momentum/config": "workspace:*",
    "@momentum/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
